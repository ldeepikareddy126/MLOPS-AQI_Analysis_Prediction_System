# =============================================================================
# AQI MLOps Project — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (single server, three databases)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aqi_user
POSTGRES_PASSWORD=changeme_strong_password

# AQI warehouse database
AQI_DB_NAME=aqi_warehouse

# Airflow metadata database
AIRFLOW_DB_NAME=airflow_metadata

# MLflow backend database (Stage B)
MLFLOW_DB_NAME=mlflow_backend

# ---------------------------------------------------------------------------
# Apache Airflow
# ---------------------------------------------------------------------------
AIRFLOW_IMAGE_TAG=2.10.5-python3.11
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here_generate_with_python_cryptography
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_key_here_change_this
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=30
# Admin user (created on first init)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin_password_change_this
AIRFLOW_ADMIN_FIRSTNAME=AQI
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@aqi-mlops.local

# ---------------------------------------------------------------------------
# Data Sources — API Keys
# ---------------------------------------------------------------------------
# OpenAQ v3 API key — register at https://explore.openaq.org/
OPENAQ_API_KEY=your_openaq_api_key_here

# Kaggle API credentials — from https://www.kaggle.com/settings → API
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# ---------------------------------------------------------------------------
# Pipeline Configuration
# ---------------------------------------------------------------------------
# Backfill range (ISO 8601 dates)
PIPELINE_BACKFILL_START=2022-01-01
PIPELINE_BACKFILL_END=

# DQ rejection rate threshold (pipeline fails if exceeded)
DQ_REJECTION_THRESHOLD=0.20

# ---------------------------------------------------------------------------
# pgAdmin (optional service)
# ---------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@aqi-mlops.local
PGADMIN_DEFAULT_PASSWORD=pgadmin_password_change_this

# ---------------------------------------------------------------------------
# MLflow (Stage B)
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow-server:5000
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# ---------------------------------------------------------------------------
# FastAPI serving (Stage B)
# ---------------------------------------------------------------------------
API_RELOAD_TOKEN=your_api_reload_token_here_change_this
API_PORT=8000

# ---------------------------------------------------------------------------
# Monitoring (Stage B)
# ---------------------------------------------------------------------------
PSI_STABLE_THRESHOLD=0.1
PSI_MODERATE_THRESHOLD=0.25
ROLLING_MAE_BASELINE_MULTIPLIER=1.5
CONSECUTIVE_DEGRADATION_DAYS=3
